# Python 3.12 recommandé pour le backend (roues pip psycopg2-binary / stack testée).
MAJORDOME_APP_NAME=MajorDome API
MAJORDOME_APP_ENV=local
MAJORDOME_DATABASE_URL=postgresql://majordome:majordome@postgres:5432/majordome
# Après déploiement / mise à jour schéma Postgres : depuis backend/ → alembic upgrade head (ou make alembic-upgrade-docker).
MAJORDOME_REDIS_URL=redis://redis:6379/0
MAJORDOME_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Depuis un telephone (meme Wi-Fi) : ajouter l'origine du front, ex.
# MAJORDOME_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.x.x:3000
# Puis frontend/.env.local avec NEXT_PUBLIC_API_BASE=http://192.168.x.x:8000 et npm run dev:lan
MAJORDOME_LLM_PROVIDER=mock
MAJORDOME_LLM_API_KEY=
MAJORDOME_LLM_MODEL=gpt-5.4-mini
MAJORDOME_LLM_BASE_URL=https://api.openai.com/v1
# Anthropic/Claude example:
# MAJORDOME_LLM_PROVIDER=anthropic
# MAJORDOME_LLM_MODEL=claude-3-5-sonnet-latest
# MAJORDOME_LLM_BASE_URL=https://api.anthropic.com/v1
MAJORDOME_HOME_ADAPTER_MODE=mock
MAJORDOME_JWT_SECRET_KEY=change-me-in-prod
MAJORDOME_JWT_ALGORITHM=HS256
MAJORDOME_JWT_EXPIRE_MINUTES=1440
MAJORDOME_JWT_REFRESH_EXPIRE_MINUTES=43200
MAJORDOME_GOOGLE_OAUTH_CLIENT_ID=
MAJORDOME_GOOGLE_OAUTH_CLIENT_SECRET=
MAJORDOME_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/oauth/callback
MAJORDOME_GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/calendar
MAJORDOME_MICROSOFT_OAUTH_CLIENT_ID=
MAJORDOME_MICROSOFT_OAUTH_CLIENT_SECRET=
MAJORDOME_MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/microsoft/oauth/callback
MAJORDOME_MICROSOFT_OAUTH_TENANT=common
MAJORDOME_MICROSOFT_OAUTH_SCOPES="openid profile offline_access Calendars.ReadWrite User.Read"
MAJORDOME_FRONTEND_BASE_URL=http://localhost:3000
MAJORDOME_OAUTH_STATE_TTL_SECONDS=600
MAJORDOME_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Quotas séparés par IP sur login / refresh (anti brute-force, en plus du quota global).
MAJORDOME_RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=15
MAJORDOME_RATE_LIMIT_AUTH_REFRESH_PER_MINUTE=60
MAJORDOME_AUTO_CREATE_TABLES=true
# Coffre documents — fichiers sur disque (Docker : volume /data/uploads)
MAJORDOME_UPLOAD_DIR=./data/uploads
MAJORDOME_ATTACHMENT_MAX_MB=12
# Total pièces jointes par foyer (0 = illimité)
MAJORDOME_ATTACHMENT_QUOTA_MB_PER_HOUSEHOLD=500
# Chiffrement coffre (Fernet) — générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAJORDOME_VAULT_ENCRYPTION_KEY=
MAJORDOME_WORKER_INTERVAL_SECONDS=30
MAJORDOME_WORKER_MAX_RETRIES=3
MAJORDOME_WORKER_RETRY_BASE_DELAY_SECONDS=2
# Frontend Next.js (pas lu par pydantic MAJORDOME_*) — URL de l’API pour fetch() depuis le navigateur.
# Doit être la même origine que celle autorisée dans MAJORDOME_CORS_ORIGINS (ex. http://localhost:8000).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Ops — alerte déploiement (optionnel, utilisé par scripts/check-deployment-alert.sh)
# Format Slack Incoming Webhook : POST JSON {"text":"..."}
# MAJORDOME_DEPLOY_ALERT_WEBHOOK=

# Délégation partenaire — URL publique de l’API (SMS / lien d’accusé). Aligner avec l’URL atteignable depuis le téléphone.
# MAJORDOME_PUBLIC_API_BASE_URL=http://localhost:8000
# MAJORDOME_DELEGATION_REMINDER_HOURS=24
# MAJORDOME_DELEGATION_MAX_REMINDERS=3
# Twilio (SMS optionnel)
# MAJORDOME_TWILIO_ACCOUNT_SID=
# MAJORDOME_TWILIO_AUTH_TOKEN=
# MAJORDOME_TWILIO_FROM_NUMBER=
# SMTP (e-mail optionnel)
# MAJORDOME_SMTP_HOST=
# MAJORDOME_SMTP_PORT=587
# MAJORDOME_SMTP_USER=
# MAJORDOME_SMTP_PASSWORD=
# MAJORDOME_SMTP_FROM_EMAIL=
# Telegram bot Alfred (voir docs/TELEGRAM_SETUP.md)
# MAJORDOME_TELEGRAM_BOT_TOKEN=
# MAJORDOME_TELEGRAM_WEBHOOK_SECRET=
# MAJORDOME_TELEGRAM_WEBHOOK_AUTO_REGISTER=true

# WhatsApp bot Alfred (voir docs/WHATSAPP_SETUP.md)
# MAJORDOME_WHATSAPP_ACCESS_TOKEN=
# MAJORDOME_WHATSAPP_PHONE_NUMBER_ID=
# MAJORDOME_WHATSAPP_APP_SECRET=
# MAJORDOME_WHATSAPP_VERIFY_TOKEN=
# MAJORDOME_WHATSAPP_DISPLAY_PHONE=+33600000000

# Stripe Premium Foyer (voir docs/STRIPE_SETUP.md)
# MAJORDOME_STRIPE_SECRET_KEY=sk_test_...
# MAJORDOME_STRIPE_WEBHOOK_SECRET=whsec_...
# MAJORDOME_STRIPE_PRICE_ID=price_...
# MAJORDOME_STRIPE_SUCCESS_URL=https://majordom.eu/?billing=success
# MAJORDOME_STRIPE_CANCEL_URL=https://majordom.eu/?billing=cancel
# MAJORDOME_PREMIUM_FOUNDER_CODE=
