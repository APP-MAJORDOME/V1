# Copier ce fichier en .env.local pour tester l'app sur un telephone (meme Wi-Fi que le Mac).
# Remplacer 192.168.x.x par l'IP LAN du Mac (ex. ipconfig getifaddr en0).
# L'API FastAPI doit ecouter sur ce meme hote:8000 (Docker mappe deja 8000, ou uvicorn sur 0.0.0.0).
#
# NEXT_PUBLIC_API_BASE=http://192.168.x.x:8000
